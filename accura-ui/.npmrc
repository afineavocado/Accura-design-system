# Storybook 10 declares peers against React 18 while this app runs React 19 /
# Next 16, so a plain `npm install` fails with ERESOLVE. Setting this here means
# it works everywhere — local, CI, and deploy platforms that run their own
# install and cannot be passed a flag — instead of relying on everyone
# remembering `--legacy-peer-deps`.
legacy-peer-deps=true
