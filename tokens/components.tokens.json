{
  "button": {
    "primary": {
      "bg": {
        "bg": {
          "$value": "{color.brand.800-base}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.brand.900}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.brand.950-darkshade}",
          "$type": "color"
        }
      },
      "fg": {
        "fg": {
          "$value": "{color.brand.primary-foreground}",
          "$type": "color"
        }
      }
    },
    "secondary": {
      "bg": {
        "bg": {
          "$value": "{color.brand.100}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.brand.50}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.brand.200}",
          "$type": "color"
        }
      },
      "fg": {
        "fg": {
          "$value": "{color.brand.900}",
          "$type": "color"
        }
      }
    },
    "destructive": {
      "bg": {
        "bg": {
          "$value": "{color.brand.destructive}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.brand.destructive-hover}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.brand.destructive-active}",
          "$type": "color"
        }
      },
      "fg": {
        "fg": {
          "$value": "{color.brand.destructive-foreground}",
          "$type": "color"
        }
      }
    },
    "outline": {
      "bg": {
        "bg": {
          "$value": "{color.surface.overlay}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.background.accent}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.background.accent}",
          "$type": "color"
        }
      },
      "fg": {
        "fg": {
          "$value": "{color.background.default-foreground}",
          "$type": "color"
        }
      },
      "border": {
        "default": {
          "$value": "{color.border.default}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.border.hover}",
          "$type": "color"
        },
        "focus": {
          "$value": "{color.ring}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.border.strong}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{color.border.disabled}",
          "$type": "color"
        }
      }
    },
    "ghost": {
      "bg": {
        "bg": {
          "$value": "{color.background.default}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.background.accent}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.background.accent}",
          "$type": "color"
        }
      },
      "fg": {
        "fg": {
          "$value": "{color.background.default-foreground}",
          "$type": "color"
        }
      }
    },
    "link": {
      "fg": {
        "default": {
          "$value": "{color.brand.800-base}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.brand.700}",
          "$type": "color"
        },
        "active": {
          "$value": "{color.brand.900}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{color.text.disabled}",
          "$type": "color"
        }
      }
    },
    "size": {
      "Button radius 1": {
        "$value": "{radius.full}",
        "$type": "number",
        "$description": "Corner radius for Large and Icon Large (11px = radius/xl)"
      },
      "Button radius 2": {
        "$value": "{radius.full}",
        "$type": "number",
        "$description": "Corner radius for Small, Default, Icon Small, Icon Default (8px = radius/base)"
      },
      "Button-height-default": {
        "$value": "{spacing.10}",
        "$type": "number",
        "$description": "Height for Default button (40px) — shadcn default"
      },
      "Button-height-small": {
        "$value": "{spacing.9}",
        "$type": "number",
        "$description": "Height for Small button (36px) — shadcn sm"
      },
      "Button-height-large": {
        "$value": "{spacing.11}",
        "$type": "number",
        "$description": "Height for Large button (44px) — shadcn lg, meets 44px touch target"
      },
      "Button spacing": {
        "$value": "{spacing.component.xs}",
        "$type": "number",
        "$description": "Gap between icon and label — all sizes (4px)"
      },
      "Button-padding-default": {
        "$value": "{spacing.4}",
        "$type": "number",
        "$description": "Horizontal padding for Default and Large (16px)"
      },
      "Button-padding-small": {
        "$value": "{spacing.3}",
        "$type": "number",
        "$description": "Horizontal padding for Small (12px)"
      }
    },
    "destructive-secondary": {
      "bg": {
        "bg": {
          "$value": "{color.red.100}",
          "$type": "color",
          "$description": "Low-emphasis destructive button, resting fill. Mirrors button/secondary (brand/100) on the red ramp."
        },
        "hover": {
          "$value": "{color.red.50}",
          "$type": "color",
          "$description": "Hover — lightens, matching button/secondary which goes brand/100 to brand/50."
        },
        "active": {
          "$value": "{color.red.200}",
          "$type": "color",
          "$description": "Pressed — darkens, matching button/secondary going to brand/200."
        }
      },
      "fg": {
        "fg": {
          "$value": "{color.red.900}",
          "$type": "color",
          "$description": "Label. red/900 not red/700: on the pressed red/200 surface, red/700 measures 4.47:1 and misses AA. red/900 holds 6.93:1 across all three states."
        }
      },
      "border": {
        "default": {
          "$value": "{color.brand.destructive}",
          "$type": "color",
          "$description": "Boundary. red/500 = 3.76:1 against white, clearing the 3:1 floor WCAG 1.4.11 sets for a control boundary. color/border/error (red/300) measures 1.90:1 and would fail — see accura-theme.md Q10."
        }
      }
    }
  },
  "badge": {
    "Badge-height-small": {
      "$value": "{spacing.4}",
      "$type": "number",
      "$description": "Badge-height-small for small badge variant"
    },
    "Badge-height-medium": {
      "$value": "{spacing.5}",
      "$type": "number",
      "$description": "Badge-height-small for medium badge variant"
    },
    "Badge-height-large": {
      "$value": "{spacing.6}",
      "$type": "number",
      "$description": "Badge-height-small for large badge variant"
    }
  },
  "table": {
    "table-cell-compact": {
      "$value": "{spacing.10}",
      "$type": "number",
      "$description": "table-cell height for compact variant"
    },
    "table-cell-default": {
      "$value": "{spacing.12}",
      "$type": "number",
      "$description": "table-cell height for default variant"
    }
  },
  "tooltip": {
    "bg": {
      "$value": "{color.background.inverted}",
      "$type": "color"
    },
    "fg": {
      "$value": "{color.background.inverted-foreground}",
      "$type": "color"
    }
  },
  "breadcrumb": {
    "breadcrumb": {
      "$value": "{spacing.component.xs}",
      "$type": "number"
    }
  },
  "stepper": {
    "border": {
      "$value": "{color.zinc.300}",
      "$type": "color"
    }
  },
  "checkbox": {
    "radius": {
      "$value": "4px",
      "$type": "dimension",
      "$description": "Checkbox corner radius. Pinned at 4px and deliberately NOT aliased to radius/md: the checkbox is 16x16, and CSS clamps border-radius to half the box, so any value >= 8 renders it as a circle indistinguishable from a radio button. radius/md is 10 after the base-12 rescale, which would do exactly that. Exists in Figma Components collection."
    }
  }
}
